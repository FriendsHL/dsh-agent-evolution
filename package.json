{
  "name": "dsh-reviewed-development-orchestrator",
  "version": "0.1.0",
  "description": "Reviewed five-stage software-development orchestration for DeepSeek Harness",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "reviewed-development",
    "orchestrator",
    "multi-agent"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "src/",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/orchestrator.test.js",
    "test:integration": "node --test test/current-dsh.integration.test.mjs",
    "check": "node --check index.js && node --check src/orchestrator.js && node --check test/current-dsh.integration.test.mjs && node --check test/fixtures/current-dsh/mock-llm.mjs && node --check test/fixtures/current-dsh/preset-headless-runner.mjs && pnpm run test",
    "prepack": "pnpm run check"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FriendsHL/dsh-reviewed-development-orchestrator.git"
  },
  "bugs": {
    "url": "https://github.com/FriendsHL/dsh-reviewed-development-orchestrator/issues"
  },
  "homepage": "https://github.com/FriendsHL/dsh-reviewed-development-orchestrator#readme",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "FriendsHL",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5",
    "@deepseek-ai/dsh-subagent": ">=0.0.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-subagent-spawn-in-process": ">=0.0.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc.1 <0.2.0",
    "@deepseek-ai/schemastery": ">=3.18.1 <4"
  },
  "packageManager": "pnpm@10.15.0"
}
